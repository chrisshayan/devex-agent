<idea-plugin>
    <id>com.devex.ambient-agent</id>
    <name>DevEx Ambient Agent</name>
    <vendor email="support@devex.ai" url="https://devex.ai">DevEx Team</vendor>
    
    <description><![CDATA[
    DevEx Ambient Agent - Intelligent development assistant that monitors your coding activity
    and provides proactive insights, morning briefings, and actionable suggestions.
    
    Works with all JetBrains IDEs: IntelliJ IDEA, PyCharm, WebStorm, PhpStorm, CLion, etc.
    ]]></description>
    
    <change-notes><![CDATA[
    <h2>0.1.0</h2>
    <ul>
        <li>Initial release with basic ambient monitoring</li>
        <li>Morning brief generation</li>
        <li>File change detection</li>
    </ul>
    ]]></change-notes>
    
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true">Git4Idea</depends>
    
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.devex.plugin.services.AmbientAgentService"/>
        <applicationService serviceImplementation="com.devex.plugin.services.NotificationService"/>
        <applicationService serviceImplementation="com.devex.plugin.settings.DevExSettings"/>
        <toolWindow id="DevEx Agent" secondary="true"
                    anchor="right" factoryClass="com.devex.plugin.ui.DevExToolWindowFactory"/>
        <notificationGroup id="DevEx Agent Notifications" displayType="BALLOON"/>
        <applicationConfigurable parentId="tools" instance="com.devex.plugin.settings.DevExSettingsConfigurable"
                                 id="devex.settings" displayName="DevEx Ambient Agent"/>
    </extensions>
    
    <applicationListeners>
        <listener class="com.devex.plugin.monitors.FileChangeMonitor"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>
</idea-plugin>
