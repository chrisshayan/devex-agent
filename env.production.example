# DevEx Ambient Agent - Production Environment Configuration
# Copy this file to .env and customize the values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=4

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate strong passwords for production
NEO4J_PASSWORD=your_secure_neo4j_password_here
REDIS_PASSWORD=your_secure_redis_password_here
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here

# =============================================================================
# API KEYS AND CREDENTIALS
# =============================================================================
# OpenAI API Key for LLM features
OPENAI_API_KEY=your_openai_api_key_here

# Confluence Integration
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
CONFLUENCE_SPACE_KEY=ARCH

# GitHub Integration
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# Vector Database (ChromaDB)
CHROMA_HOST=chroma
CHROMA_PORT=8001
VECTOR_DB_PATH=/app/data/vector_store

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# KNOWLEDGE GRAPH CONFIGURATION
# =============================================================================
KNOWLEDGE_GRAPH_ENABLED=true
RELATIONSHIP_ENGINE_ENABLED=true
ENABLE_CACHING=true
CACHE_TTL=3600

# Advanced Relationship Discovery
RELATIONSHIP_ENGINE_CONFIG='{
  "similarity_threshold": 0.7,
  "pattern_threshold": 0.6,
  "dependency_confidence": 0.5,
  "enable_caching": true,
  "algorithms": {
    "code_dependencies": true,
    "semantic_similarity": true,
    "design_patterns": true,
    "cross_references": true,
    "hierarchical": true,
    "temporal": true
  }
}'

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
MAX_WORKERS=4
CACHE_SIZE=1000
VECTOR_SEARCH_LIMIT=100
RELATIONSHIP_DISCOVERY_BATCH_SIZE=20

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Prometheus metrics
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Log aggregation
ELASTICSEARCH_ENABLED=true
KIBANA_ENABLED=true
LOG_RETENTION_DAYS=30

# =============================================================================
# SSL/TLS CONFIGURATION (for production)
# =============================================================================
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem
# ENABLE_HTTPS=true

# =============================================================================
# BACKUP AND STORAGE
# =============================================================================
# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Data persistence
DATA_VOLUME_PATH=./data
LOGS_VOLUME_PATH=./logs
CONFIG_VOLUME_PATH=./config

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Slack notifications for alerts (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# SLACK_CHANNEL=#devex-alerts

# Email notifications (optional)
# SMTP_HOST=smtp.yourcompany.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourcompany.com
# SMTP_PASSWORD=your_smtp_password
# ADMIN_EMAIL=admin@yourcompany.com

# =============================================================================
# SCALING AND DEPLOYMENT
# =============================================================================
# Docker settings
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Load balancing (if running multiple instances)
# LOAD_BALANCER_ENABLED=true
# AGENT_REPLICAS=3

# Health check settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# DEVELOPMENT OVERRIDES (remove in production)
# =============================================================================
# These should be removed or set to false in production
DEV_MODE=false
HOT_RELOAD=false
DEBUG_SQL=false
VERBOSE_LOGGING=false 