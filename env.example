# DevEx Ambient Agent Configuration

# OpenAI API Key (required for LLM analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Agent Configuration
HOST=localhost
PORT=8000
DEBUG=true

# LLM Settings
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.1

# Ambient Agent Settings
AMBIENT_CHECK_INTERVAL=300
MAX_EVENTS_PER_DEVELOPER=1000
EVENT_RETENTION_HOURS=168

# Storage
DATABASE_URL=sqlite:///./devex_agent.db
VECTOR_DB_PATH=./data/vector_store

# Logging
LOG_level=INFO 